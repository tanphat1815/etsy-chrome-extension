{
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "javascript-obfuscator": "^5.3.0"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fix:strict": "eslint . --fix --max-warnings=0",

    "build": "node scripts/build.mjs",
    "build:samples": "node scripts/build.mjs --include-samples",
    "build:obf": "node scripts/build.mjs --obfuscate",
    "zip": "node scripts/zip.mjs",

    "release": "npm run build && npm run zip",
    "release:obf": "npm run build:obf && npm run zip"
  }
}
